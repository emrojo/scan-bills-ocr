# Server Configuration (Default 8030 to avoid collisions)
HOST=0.0.0.0
PORT=8030

# Ollama Backend
OLLAMA_BASE_URL=http://localhost:11434
# When running with Docker Compose:
# OLLAMA_BASE_URL=http://ollama:11434

# VLM Model Selection
# Options: qwen2.5vl:7b (Recommended, high accuracy) | qwen2.5vl:3b (Ultra fast)
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_FALLBACK_MODEL=qwen2.5vl:3b

# Preprocessing Options
PDF_DPI=200
MAX_IMAGE_DIM=2048
TIMEOUT_SECONDS=300.0
